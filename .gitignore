# acii_os — no build step, zero deps, nothing to ignore from tooling.
# These are just defensive entries for editor / OS cruft.

.DS_Store
*.log

# Secrets — never commit (CI uses the CLOUDFLARE_API_TOKEN GitHub secret).
.env
.env.*
.dev.vars
.dev.vars.*

.vscode/
.idea/
*.swp
*~

# ── Capacitor / native iOS wrapper (cz.fakan.os) ──
# Node toolchain + assembled web build are dev-time only, never committed.
node_modules/
www/

# Native iOS project generated by `npx cap add ios`; regenerate with
# `npm run ios:add`. Remove this line if you decide to commit the ios/ project.
ios/
.claude/tmp/
