# FakanOS — no build step, zero deps, nothing to ignore from tooling.
# These are just defensive entries for editor / OS cruft.

.DS_Store
*.log

# Secrets — never commit (CI uses the CLOUDFLARE_API_TOKEN GitHub secret).
.env
.env.*
.dev.vars
.dev.vars.*

.vscode/
.idea/
*.swp
*~

# ── Capacitor / native iOS wrapper (cz.fakan.os) ──
# Node toolchain + assembled web build are dev-time only, never committed.
node_modules/
www/

# Native iOS project is COMMITTED (Xcode Cloud builds straight from git).
# Generated bits inside it (Pods/, www → App/App/public, node config, build/,
# DerivedData, xcuserdata) stay ignored via ios/.gitignore and are regenerated
# in CI by ios/App/ci_scripts/ci_post_clone.sh. See CAPACITOR.md §8.
.claude/tmp/

# Wrangler local dev state (miniflare KV, build cache) — never committed.
.wrangler/
